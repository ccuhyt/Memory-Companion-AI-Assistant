# Copy this file to .env and fill in your own values.
# Do not commit the real .env file or any API keys to GitHub.

# OpenRouter API key used by story generation and other LLM features
OPENROUTER_API_KEY=

# Main chat code reads this variable.
# If using the same OpenRouter account, you can use the same key as above.
LLM_API_KEY=

# Groq API key used for Speech-to-Text
GROQ_API_KEY=

# Google Calendar target account
USER_GMAIL=example@gmail.com
